-- float32_easing.nelua -- extracted from Raylib.nelua/rayeasings.nelua
-- (rle.quadOut). A polynomial easing function over `float32` with an
-- `<inline>` attribute; no math module is needed. Isolates: float32
-- arithmetic and float32 print formatting.
local function quadOut(t: float32, b: float32, c: float32, d: float32): float32 <inline>
  return -c * t * (t - 2) + b
end

print(quadOut(0.0, 0.0, 100.0, 1.0))
print(quadOut(0.5, 0.0, 100.0, 1.0))
print(quadOut(1.0, 0.0, 100.0, 1.0))