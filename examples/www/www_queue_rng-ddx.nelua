local rng_state: int64 = 1
local function rng_seed(s: int64)
  rng_state = s
end
local function rng_next(max: integer): integer
  rng_state = (rng_state * 1103515245 + 12345) % 2147483648
  local r = rng_state % max
  if r < 0 then r = r + max end
  return r + 1
end
rng_seed(42)
for i = 1, 5 do
  print(rng_next(100))
end
