local function square(n: integer): integer
  return n * n
end
local s = 0
for i = 1, 10 do
  s = s + square(i)
end
print(s)

local t = 0
for i = 1, 3 do
  for j = 1, 3 do
    t = t + i * j
  end
end
print(t)

local function fib(n: integer): integer
  if n <= 1 then return n end
  return fib(n - 1) + fib(n - 2)
end
print(fib(12))
