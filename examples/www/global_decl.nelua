-- global_decl.nelua -- extracted from zxplayer nelua/queue.nelua and
-- nelua/types.nelua. A file-scope `global` variable that is read and
-- mutated at top level, plus a `global` record type. Isolates: the
-- `global` declaration form at file scope.
global counter: integer = 0
global Point = @record{ x: integer, y: integer }

counter = counter + 1
counter = counter + 1
print(counter)

local p = Point{ x = 3, y = 4 }
print(p.x, p.y)