-- Nested array element read in a method return position: our emitter
-- wraps the read in nlany_load_int(...) but the element is a plain int64.
local Grid = @record{ cells: [2][2]integer }
function Grid:get(i: integer, j: integer): integer
  return self.cells[i][j]
end
local g: Grid
g.cells[0][0] = 5
g.cells[1][1] = 8
print(g:get(0,0), g:get(1,1))
