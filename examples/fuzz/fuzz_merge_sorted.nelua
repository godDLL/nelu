require 'string'
-- Merge two sorted arrays into one sorted array.
local a: [3]integer = {1, 3, 5}
local b: [3]integer = {2, 4, 6}
local c: [6]integer
local i = 0
local j = 0
local k = 0
while i < #a and j < #b do
  if a[i] <= b[j] then
    c[k] = a[i]
    i = i + 1
  else
    c[k] = b[j]
    j = j + 1
  end
  k = k + 1
end
while i < #a do
  c[k] = a[i]
  i = i + 1
  k = k + 1
end
while j < #b do
  c[k] = b[j]
  j = j + 1
  k = k + 1
end
local out = ""
for i = 0, #c - 1 do
  if out ~= "" then out = out .. " " end
  out = out .. tostring(c[i])
end
print(out)
