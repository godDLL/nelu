require 'string'
-- FizzBuzz for the numbers 1..20 using a switch on divisibility.
local out = ""
for i = 1, 20 do
  switch i % 15
  case 0 then
    out = out .. "FizzBuzz"
  case 3, 6, 9, 12 then
    out = out .. "Fizz"
  case 5, 10 then
    out = out .. "Buzz"
  else
    if out ~= "" then out = out .. " " end
    out = out .. tostring(i)
  end
end
print(out)
