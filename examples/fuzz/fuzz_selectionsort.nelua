require 'string'
-- Selection sort on a fixed-size array.
local a: [8]integer = {3, 1, 4, 1, 5, 9, 2, 6}
for i = 0, #a - 2 do
  local min_idx = i
  for j = i + 1, #a - 1 do
    if a[j] < a[min_idx] then
      min_idx = j
    end
  end
  a[i], a[min_idx] = a[min_idx], a[i]
end
local s = ""
for i = 0, #a - 1 do
  if i > 0 then s = s .. " " end
  s = s .. tostring(a[i])
end
print(s)
