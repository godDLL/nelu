-- Stack implemented as a record with push/pop methods.
local Stack = @record{
  data: [8]integer,
  top: integer
}

function Stack:push(v: integer)
  self.data[self.top] = v
  self.top = self.top + 1
end

function Stack:pop(): integer
  self.top = self.top - 1
  return self.data[self.top]
end

local s: Stack
s:push(1)
s:push(2)
s:push(3)
print(s:pop(), s:pop(), s:pop())
