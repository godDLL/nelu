require 'string'
-- Bubble sort on a fixed-size array.
local a: [8]integer = {3, 1, 4, 1, 5, 9, 2, 6}
local n = #a
repeat
  local swapped = false
  for i = 0, n - 2 do
    if a[i] > a[i + 1] then
      a[i], a[i + 1] = a[i + 1], a[i]
      swapped = true
    end
  end
until not swapped
local s = ""
for i = 0, #a - 1 do
  if i > 0 then s = s .. " " end
  s = s .. tostring(a[i])
end
print(s)
