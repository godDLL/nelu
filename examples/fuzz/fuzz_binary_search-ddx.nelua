-- Binary search on a sorted fixed-size array.
local a: [8]integer = {1, 1, 2, 3, 4, 5, 6, 9}
local target = 5
local lo = 0
local hi = #a - 1
local idx = -1
while lo <= hi do
  local mid = (lo + hi) // 2
  if a[mid] == target then
    idx = mid
    break
  elseif a[mid] < target then
    lo = mid + 1
  else
    hi = mid - 1
  end
end
print(idx)
