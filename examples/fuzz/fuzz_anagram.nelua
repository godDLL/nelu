-- Anagram check using character frequency counters.
require 'string'
local a = "listen"
local b = "silent"
local ca: [26]integer
local cb: [26]integer
for i = 1, #a do
  local c = string.byte(a, i) - 97
  ca[c] = ca[c] + 1
end
for i = 1, #b do
  local c = string.byte(b, i) - 97
  cb[c] = cb[c] + 1
end
local same = true
for i = 0, 25 do
  if ca[i] ~= cb[i] then
    same = false
  end
end
print(same)
