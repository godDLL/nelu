require 'string'
-- Radix sort (base 10, LSD) on a fixed-size array.
local a: [8]integer = {170, 45, 75, 90, 2, 24, 66, 99}
local n = #a
local exp = 1
local tmp: [8]integer
while true do
  local maxv = 0
  for i = 0, n - 1 do
    local d = (a[i] // exp) % 10
    if d > maxv then
      maxv = d
    end
  end
  if maxv == 0 then
    break
  end
  local count: [10]integer
  for i = 0, 9 do
    count[i] = 0
  end
  for i = 0, n - 1 do
    count[(a[i] // exp) % 10] = count[(a[i] // exp) % 10] + 1
  end
  for i = 1, 9 do
    count[i] = count[i] + count[i - 1]
  end
  for i = n - 1, 0, -1 do
    local d = (a[i] // exp) % 10
    tmp[count[d] - 1] = a[i]
    count[d] = count[d] - 1
  end
  for i = 0, n - 1 do
    a[i] = tmp[i]
  end
  exp = exp * 10
end
local out = ""
for i = 0, n - 1 do
  if out ~= "" then out = out .. " " end
  out = out .. tostring(a[i])
end
print(out)
