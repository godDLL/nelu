-- Nelu: `any` runtime dispatch -- a typed value stored in `any` can be
-- loaded back out to its original type.  The oracle rejects the `any`
-- variable declarations outright.
local a: any = 42
local b: any = true
local c: any = 3.5
local d: any = "hi"
local x: integer = a
local y: boolean = b
local z: double = c
local w: string = d
print(x, y, z, w)
