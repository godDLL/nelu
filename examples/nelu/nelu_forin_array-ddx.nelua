-- Nelu: `for v in array` iterates a typed array by value.  The oracle
-- rejects `for ... in` over a typed array (it only supports `pairs` over
-- tables, which the C backend does not have); ours lowers it to a
-- indexed loop.
local arr: [4]integer = { 10, 20, 30, 40 }
local sum: integer = 0
for v in arr do
  sum = sum + v
end
print(sum)
