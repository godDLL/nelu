require 'string'
-- Depth-first search on a small fixed graph (recursive).
local adj: [6][3]integer = {
  {1, 2, -1},
  {0, 3, -1},
  {0, 4, -1},
  {1, 5, -1},
  {2, 5, -1},
  {3, 4, -1}
}
local visited: [6]boolean
local out = ""

local function dfs(u: integer)
  visited[u] = true
  if out ~= "" then out = out .. " " end
  out = out .. tostring(u)
  for i = 0, 2 do
    local v = adj[u][i]
    if v >= 0 and not visited[v] then
      dfs(v)
    end
  end
end

dfs(0)
print(out)
