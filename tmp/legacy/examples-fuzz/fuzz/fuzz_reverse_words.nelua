-- Reverse the order of words in a string.
require 'string'
local s = "hello world from nelua"
local words: [4]cstring
local wc = 0
local start = 1
for i = 1, #s + 1 do
  local ch = (i <= #s) and string.sub(s, i, i) or " "
  if ch == " " then
    if start <= i - 1 then
      words[wc] = string.sub(s, start, i - 1)
      wc = wc + 1
    end
    start = i + 1
  end
end
local out = ""
for i = wc - 1, 0, -1 do
  if out ~= "" then out = out .. " " end
  out = out .. words[i]
end
print(out)
