-- Palindrome check by comparing characters from both ends.
require 'string'
local function is_palindrome(s: cstring): boolean
  local n = #s
  for i = 1, n // 2 do
    if string.sub(s, i, i) ~= string.sub(s, n - i + 1, n - i + 1) then
      return false
    end
  end
  return true
end
print(is_palindrome("racecar"), is_palindrome("hello"))
