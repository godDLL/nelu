-- Matrix multiplication of two 2x2 matrices.
local a: [2][2]integer = {{1, 2}, {3, 4}}
local b: [2][2]integer = {{5, 6}, {7, 8}}
local c: [2][2]integer
for i = 0, 1 do
  for j = 0, 1 do
    local s = 0
    for k = 0, 1 do
      s = s + a[i][k] * b[k][j]
    end
    c[i][j] = s
  end
end
print(c[0][0], c[0][1], c[1][0], c[1][1])
