require 'string'
-- Breadth-first search on a small fixed graph.
require 'iterators'
local adj: [6][3]integer = {
  {1, 2, -1},
  {0, 3, -1},
  {0, 4, -1},
  {1, 5, -1},
  {2, 5, -1},
  {3, 4, -1}
}
local visited: [6]boolean
local queue: [6]integer
local qh = 0
local qt = 0
queue[qt] = 0
qt = qt + 1
visited[0] = true
local out = ""
while qh < qt do
  local u = queue[qh]
  qh = qh + 1
  if out ~= "" then out = out .. " " end
  out = out .. tostring(u)
  for _, v in ipairs(adj[u]) do
    if v >= 0 and not visited[v] then
      visited[v] = true
      queue[qt] = v
      qt = qt + 1
    end
  end
end
print(out)
