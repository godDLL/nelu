require 'string'
-- Insertion sort on a fixed-size array.
local a: [8]integer = {3, 1, 4, 1, 5, 9, 2, 6}
for i = 1, #a - 1 do
  local key = a[i]
  local j = i - 1
  while j >= 0 and a[j] > key do
    a[j + 1] = a[j]
    j = j - 1
  end
  a[j + 1] = key
end
local s = ""
for i = 0, #a - 1 do
  if i > 0 then s = s .. " " end
  s = s .. tostring(a[i])
end
print(s)
