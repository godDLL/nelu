-- Sieve of Eratosthenes counting primes up to a comptime bound.
local N <comptime> = 100
local is_prime: [N + 1]boolean
for i = 2, N do
  is_prime[i] = true
end
for i = 2, N do
  if is_prime[i] then
    for j = i + i, N, i do
      is_prime[j] = false
    end
  end
end
local count = 0
for i = 2, N do
  if is_prime[i] then
    count = count + 1
  end
end
print(count)
