-- Binomial coefficient C(n, k) via multiplicative formula.
local function choose(n: integer, k: integer): integer
  if k < 0 or k > n then
    return 0
  end
  if k > n - k then
    k = n - k
  end
  local r: integer = 1
  for i = 1, k do
    r = r * (n - k + i) // i
  end
  return r
end
print(choose(5, 2))
