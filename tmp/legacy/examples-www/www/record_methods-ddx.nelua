-- record_methods.nelua -- extracted from zxplayer nelua/queue.nelua
-- (the Queue record) and Raylib.nelua/rayeasings.nelua. A `@record`
-- with two colon methods: one returning a value, one mutating self with
-- a unary operation. Isolates: record methods, self mutation.
local Point = @record{ x: integer, y: integer }

function Point:sum(): integer
  return self.x + self.y
end

function Point:neg()
  self.x = -self.x
  self.y = -self.y
end

local p = Point{ x = 3, y = 4 }
print(p:sum())
p:neg()
print(p.x, p.y)