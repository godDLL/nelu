-- Nelu: `<mustcheck>` marks a function's return value as not discardable.
-- The oracle has no `<mustcheck>` and rejects it; ours accepts the
-- annotation and runs the body normally.
local function divide(a: integer, b: integer): integer <mustcheck>
  if b == 0 then
    error "division by zero"
  end
  return a // b
end
print(divide(10, 2))
