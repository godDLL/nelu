--[[
tic-tac-toe.nelua

A two-player tic-tac-toe game server over a Unix domain socket.

Run it (the socket path defaults to `tmp/tic-tac-toe.sock` in the current
directory, or pass your own as the first argument), then connect two
players, each in its own terminal:

    nc -U tmp/tic-tac-toe.sock

Each player is told its symbol (X or O), sees the board after every move,
and is prompted for "row col" (1-indexed) when it is its turn. The server
adjudicates: invalid input, occupied cells, wins and draws, and opponent
disconnection.

The socket syscalls are thin C wrappers emitted with `## cemitdefn` and
imported with `<cimport>`; all the game logic is plain Nelua.
--]]

require 'string'
require 'arg'

## cinclude '<sys/socket.h>'
## cinclude '<sys/un.h>'
## cinclude '<unistd.h>'
## cinclude '<string.h>'
## cinclude '<signal.h>'

##[==[
cemitdefn([[
int ttt_make_server(char* path) {
  signal(SIGPIPE, SIG_IGN);
  int fd = socket(AF_UNIX, SOCK_STREAM, 0);
  if (fd < 0) return -1;
  struct sockaddr_un addr;
  addr.sun_family = AF_UNIX;
  unlink(path);
  strncpy(addr.sun_path, path, sizeof(addr.sun_path) - 1);
  addr.sun_path[sizeof(addr.sun_path) - 1] = 0;
  if (bind(fd, (struct sockaddr*)&addr, sizeof(addr)) < 0) { close(fd); return -1; }
  if (listen(fd, 2) < 0) { close(fd); return -1; }
  return fd;
}

int ttt_accept(int fd) {
  return accept(fd, 0, 0);
}

long ttt_send_str(int fd, char* s) {
  size_t n = strlen(s);
  long sent = 0;
  while (sent < (long)n) {
    long r = send(fd, s + sent, (size_t)(n - sent), 0);
    if (r <= 0) return r;
    sent += r;
  }
  return sent;
}

long ttt_read_line(int fd, void* vbuf, size_t maxlen) {
  char* buf = (char*)vbuf;
  size_t i = 0;
  while (i + 1 < maxlen) {
    char c;
    long r = recv(fd, &c, 1, 0);
    if (r <= 0) return r;
    if (c == '\n') break;
    buf[i++] = c;
  }
  buf[i] = 0;
  return (long)i;
}

long ttt_parse_move(void* vbuf) {
  char* buf = (char*)vbuf;
  int r, c;
  if (sscanf(buf, "%d %d", &r, &c) != 2) return -1;
  if (r < 1 || r > 3 || c < 1 || c > 3) return -1;
  return (r - 1) * 3 + (c - 1);
}
]])
]==]

local function ttt_make_server(path: cstring): cint <cimport"ttt_make_server"> end
local function ttt_accept(fd: cint): cint <cimport"ttt_accept"> end
local function ttt_send_str(fd: cint, s: cstring): clong <cimport"ttt_send_str"> end
local function ttt_read_line(fd: cint, buf: pointer, maxlen: csize): clong <cimport"ttt_read_line"> end
local function ttt_parse_move(buf: pointer): clong <cimport"ttt_parse_move"> end
local function c_close(fd: cint): cint <cimport"close", cinclude"<unistd.h>"> end
local function c_unlink(path: cstring): cint <cimport"unlink", cinclude"<unistd.h>"> end

-- board is a flat 9-cell array, row-major, 0-indexed; 0 = empty, 1 = X, 2 = O
local LINES: [8][3]integer = {
  { 0, 1, 2 }, { 3, 4, 5 }, { 6, 7, 8 },
  { 0, 3, 6 }, { 1, 4, 7 }, { 2, 5, 8 },
  { 0, 4, 8 }, { 2, 4, 6 }
}

local function sym(n: integer): string
  if n == 0 then return "." end
  if n == 1 then return "X" end
  return "O"
end

local function render(b: [9]integer): string
  return "   1 2 3\n1 " .. sym(b[0]) .. " " .. sym(b[1]) .. " " .. sym(b[2]) .. "\n" ..
         "2 " .. sym(b[3]) .. " " .. sym(b[4]) .. " " .. sym(b[5]) .. "\n" ..
         "3 " .. sym(b[6]) .. " " .. sym(b[7]) .. " " .. sym(b[8]) .. "\n"
end

local function winner(b: [9]integer): integer
  for i = 0, 7 do
    local a = LINES[i][0]
    local d = LINES[i][1]
    local e = LINES[i][2]
    if b[a] ~= 0 and b[a] == b[d] and b[d] == b[e] then
      return b[a]
    end
  end
  return 0
end

local function play_game(xfd: cint, ofd: cint)
  local board: [9]integer = {}
  local turn = 1
  local moves = 0

  ttt_send_str(xfd, "SYMBOL X\n")
  ttt_send_str(ofd, "SYMBOL O\n")

  while true do
    local curfd = (turn == 1) and xfd or ofd
    local cursym = (turn == 1) and "X" or "O"

    local rb = render(board)
    ttt_send_str(xfd, "BOARD\n" .. rb)
    ttt_send_str(ofd, "BOARD\n" .. rb)
    ttt_send_str(curfd, "YOUR_TURN\n")
    ttt_send_str((turn == 1) and ofd or xfd, "WAIT\n")

    local buf: [64]cchar = {}
    local r = ttt_read_line(curfd, &buf[0], 63)
    if r <= 0 then
      ttt_send_str((turn == 1) and ofd or xfd, "OPPONENT_LEFT\n")
      break
    end

    local idx = ttt_parse_move(&buf[0])
    if idx < 0 then
      ttt_send_str(curfd, "INVALID: type 'row col' each 1-3\n")
    elseif board[idx] ~= 0 then
      ttt_send_str(curfd, "TAKEN: pick an empty cell\n")
    else
      board[idx] = turn
      moves = moves + 1
      local w = winner(board)
      if w ~= 0 then
        local rb2 = render(board)
        ttt_send_str(xfd, "BOARD\n" .. rb2)
        ttt_send_str(ofd, "BOARD\n" .. rb2)
        ttt_send_str(xfd, "WIN " .. cursym .. "\n")
        ttt_send_str(ofd, "WIN " .. cursym .. "\n")
        break
      elseif moves == 9 then
        local rb2 = render(board)
        ttt_send_str(xfd, "BOARD\n" .. rb2)
        ttt_send_str(ofd, "BOARD\n" .. rb2)
        ttt_send_str(xfd, "DRAW\n")
        ttt_send_str(ofd, "DRAW\n")
        break
      else
        turn = (turn == 1) and 2 or 1
      end
    end
  end
end

local function main()
  local socket_path = (#arg > 0) and arg[1] or "tmp/tic-tac-toe.sock"
  print("Tic-Tac-Toe: two players over a Unix socket")
  print("connect each player with: nc -U " .. socket_path)

  local sfd = ttt_make_server(socket_path)
  if sfd < 0 then
    error("failed to create/bind socket at " .. socket_path)
  end
  print("listening on " .. socket_path)

  print("waiting for player X...")
  local xfd = ttt_accept(sfd)
  print("player X connected")

  print("waiting for player O...")
  local ofd = ttt_accept(sfd)
  print("player O connected")
  print("game on")

  play_game(xfd, ofd)

  c_close(xfd)
  c_close(ofd)
  c_close(sfd)
  c_unlink(socket_path)
  print("socket closed")
end

main()